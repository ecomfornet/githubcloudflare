PORT=3000
HOST=0.0.0.0

# Optional Cloudflare Workers / Pages credentials
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCOUNT_SUBDOMAIN=
CLOUDFLARE_PROJECT_NAME=
CLOUDFLARE_DEPLOYMENT_TYPE=workers_assets
CLOUDFLARE_CUSTOM_DOMAIN=

# Optional GitHub Pages credentials
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_IS_ORG=true
GITHUB_BASE_PATH=

# Optional Content Ingestion & Branding overrides
SITEMAP_URL=
WP_API_URL=
MAX_POSTS=100
DOWNLOAD_IMAGES=true
THEME=nordic-studio
ROUTING_MODE=single
OUTPUT_DIR=dist
BRAND_NAME=Atelier Maison
